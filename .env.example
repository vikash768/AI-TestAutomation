# =============================================================================
# AI Testing Automation — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for YOUR project.
# NEVER commit .env to source control.
#
# The same framework tests any project by changing this configuration.
# No source code modification is required.
# =============================================================================

# ============================================================
# TARGET
# ============================================================

# web | mobile | desktop
TARGET_TYPE=web

# Logical project name used in logs, artifacts, and metrics
PROJECT_NAME=

# Optional by default: source repository URL for AI/source inspection.
# Full native commands require it when *_REQUIRE_REPO_CONTEXT=true.
APP_REPO_URL=
APP_REPO_REF=
APP_REPO_LOCAL_PATH=

# Optional for private GitHub repositories. Prefer GH_TOKEN in your local .env
# or shell/CI secret store; never commit a token.
GH_TOKEN=

# Fail before test generation when required source/build context is unavailable.
REQUIRE_REPO_CONTEXT=false
REQUIRE_BUILD_CONTEXT=false

# ============================================================
# WEB TARGET
# Used only when TARGET_TYPE=web
# ============================================================

BASE_URL=
BROWSER=chrome
WEB_PROJECT_NAME=
WEB_TEST_SUITE=
WEB_BASE_URL=
WEB_APP_REPO_URL=
WEB_APP_REPO_LOCAL_PATH=

# ============================================================
# SELENIUM (Web)
# Used only when TARGET_TYPE=web
# ============================================================

SELENIUM_REMOTE_URL=http://selenium:4444
SELENIUM_PORT=4444
SELENIUM_VNC_PORT=7900
SELENIUM_VNC_PASSWORD=

# ============================================================
# APP TARGET
# Used for mobile / desktop where applicable
# Single generic path — supports .apk, .ipa, .dmg, .app, .exe
# ============================================================

APP_BUILD_PATH=

# ============================================================
# APPIUM
# Used only when TARGET_TYPE=mobile or TARGET_TYPE=desktop
# ============================================================

APPIUM_SERVER_URL=http://127.0.0.1:4723

# android | ios | macos | windows
APPIUM_PLATFORM=

DEVICE_NAME=

# Optional AVD name. If empty and exactly one AVD exists, it is auto-selected.
ANDROID_AVD=

# Demo helpers automatically start a missing local emulator/Appium server.
ANDROID_EMULATOR_AUTOSTART=true
APPIUM_AUTOSTART=true

# Clear the Android app's local data before a run (enabled by make demo-mobile)
MOBILE_RESET_APP=false

# Android optional
APP_PACKAGE=
APP_ACTIVITY=

# iOS / macOS optional
BUNDLE_ID=

# ============================================================
# TARGET-SPECIFIC APP CONFIGURATION (preferred)
# These values override the generic APP/APPIUM values for their target.
# ============================================================

MOBILE_PROJECT_NAME=
MOBILE_TEST_SUITE=
MOBILE_APP_REPO_URL=
MOBILE_APP_REPO_REF=
MOBILE_APP_REPO_LOCAL_PATH=
MOBILE_APP_BUILD_PATH=
MOBILE_APPIUM_PLATFORM=android
MOBILE_APPIUM_SERVER_URL=http://127.0.0.1:4723
MOBILE_DEVICE_NAME=
MOBILE_APP_PACKAGE=
MOBILE_APP_ACTIVITY=
MOBILE_BUNDLE_ID=
MOBILE_REQUIRE_REPO_CONTEXT=true
MOBILE_REQUIRE_BUILD_CONTEXT=true

DESKTOP_PROJECT_NAME=
DESKTOP_TEST_SUITE=testsuites/desktop-app.testsuite.md
DESKTOP_APP_REPO_URL=
DESKTOP_APP_REPO_REF=
DESKTOP_APP_REPO_LOCAL_PATH=
DESKTOP_APP_BUILD_PATH=
DESKTOP_APPIUM_PLATFORM=macos
DESKTOP_APPIUM_SERVER_URL=http://127.0.0.1:4723
DESKTOP_DEVICE_NAME=
DESKTOP_APP_PACKAGE=
DESKTOP_APP_ACTIVITY=
DESKTOP_BUNDLE_ID=
DESKTOP_REQUIRE_REPO_CONTEXT=true
DESKTOP_REQUIRE_BUILD_CONTEXT=true

# ============================================================
# AI CONFIGURATION
# ============================================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: limit AI categories for a shorter live demo (full suite when empty)
AI_MAX_CATEGORIES=
AI_MAX_TESTS=

# Full commands fail instead of silently skipping Markdown instructions.
REQUIRE_FULL_MD_COVERAGE=false

# ============================================================
# TEST CREDENTIALS (optional)
# ============================================================

# Generic fallback credentials
VALID_USER_EMAIL=
VALID_USER_PASSWORD=

# Preferred when the web and mobile applications use different accounts
WEB_VALID_USER_EMAIL=
WEB_VALID_USER_PASSWORD=
MOBILE_VALID_USER_EMAIL=
MOBILE_VALID_USER_PASSWORD=

# ============================================================
# TEST SUITE
# ============================================================

TEST_SUITE=

# ============================================================
# OBSERVABILITY
# ============================================================

PUSHGATEWAY_URL=http://pushgateway:9091
PUSHGATEWAY_PORT=9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ============================================================
# GRAFANA
# ============================================================

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# ============================================================
# DEMO APP (optional)
# ============================================================

DEMO_APP_PORT=8080
