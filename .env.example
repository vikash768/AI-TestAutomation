# =============================================================================
# AI-TestAutomation — environment
# Copy to .env. Everything here is read by docker compose and by the local CLI.
# =============================================================================

# --- Defaults shown in the web form (optional) ---
PROJECT_NAME=trackpilot
TARGET_REPO_URL=https://github.com/org/frontend.git
TARGET_LIVE_URL=https://app.example.com
VALID_USER_EMAIL=
VALID_USER_PASSWORD=

# --- LLM (intent summaries from source code; credentials never leave the machine) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when the primary model answers 429/503; set empty to disable
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_INTENT=true

# --- Private repositories (optional; public repos clone without it) ---
GITHUB_TOKEN=

# --- Storage ---
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa
POSTGRES_DB=qa
POSTGRES_PORT=5434
# Local CLI / tests only; inside docker compose the URL is set automatically
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5434/qa
ARTIFACTS_DIR=artifacts

# --- Secrets at rest (run credentials are encrypted with a key derived from this) ---
QA_SECRET_KEY=change-me-to-a-long-random-string

# --- Browser / crawl limits ---
HEADLESS=true
MAX_PAGES=60
MAX_ELEMENTS_PER_PAGE=150
NAV_TIMEOUT_MS=20000
ACTION_TIMEOUT_MS=5000
SETTLE_MS=1200

# --- Ports and public URLs ---
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
GRAFANA_PORT=3000
GRAFANA_PUBLIC_URL=http://localhost:3000
PROMETHEUS_PORT=9090
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
