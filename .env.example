# =============================================================================
# AI-TestAutomation — environment
# Copy to .env. Everything here is read by docker compose and by the local CLI.
# =============================================================================

# --- Defaults shown in the web form (optional) ---
PROJECT_NAME=trackpilot
TARGET_REPO_URL=https://github.com/org/frontend.git
TARGET_LIVE_URL=https://app.example.com
VALID_USER_EMAIL=
VALID_USER_PASSWORD=

# --- Native app defaults for the form's Android / macOS platforms (optional) ---
# Build: a file path (.apk, .ipa, .app, .dmg) or an installed app id (com.example.app).
ANDROID_PROJECT_NAME=
ANDROID_REPO_URL=
# Optional second codebase: the app's backend API (routes for journeys and load-test targets; not counted in UI coverage)
ANDROID_BACKEND_REPO_URL=
ANDROID_APP_PATH=
ANDROID_USER_EMAIL=
ANDROID_USER_PASSWORD=
# Token for the Android repo when it differs from GITHUB_TOKEN (used when the form's token field is empty)
ANDROID_GITHUB_TOKEN=
# Token for the backend repo (second codebase line) when it lives in another account
ANDROID_BACKEND_GITHUB_TOKEN=
DESKTOP_PROJECT_NAME=
DESKTOP_REPO_URL=
DESKTOP_APP_PATH=
# Platform the form opens with: web | android | ios | macos
DEFAULT_PLATFORM=web

# --- Appium (native runs; used by the host worker started with `make app-worker`) ---
APPIUM_SERVER_URL=http://127.0.0.1:4723
# Start `appium` automatically when nothing answers at a local APPIUM_SERVER_URL
APPIUM_AUTOSTART=true
# Android: device serial (empty = first connected); AVD to boot when none is connected
DEVICE_NAME=
ANDROID_AVD=
MAX_SCREENS=25
APP_LAUNCH_TIMEOUT_S=60

# --- LLM (intent summaries from source code; credentials never leave the machine) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when the primary model answers 429/503; set empty to disable
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_INTENT=true

# --- Private repositories (optional; public repos clone without it; the form's token field overrides it) ---
GITHUB_TOKEN=

# --- Storage ---
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa
POSTGRES_DB=qa
POSTGRES_PORT=5434
# Local CLI / tests only; inside docker compose the URL is set automatically
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5434/qa
ARTIFACTS_DIR=artifacts

# --- Secrets at rest (run credentials are encrypted with a key derived from this) ---
QA_SECRET_KEY=change-me-to-a-long-random-string

# --- Browser / crawl limits ---
HEADLESS=true
MAX_PAGES=60
MAX_ELEMENTS_PER_PAGE=150
NAV_TIMEOUT_MS=20000
ACTION_TIMEOUT_MS=5000
SETTLE_MS=1200

# --- Ports and public URLs ---
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
GRAFANA_PORT=3000
GRAFANA_PUBLIC_URL=http://localhost:3000
PROMETHEUS_PORT=9090
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Native journeys with QA test data ---
# Seconds the journeys may take in one run (planning from the code, and from the LLM when GEMINI_API_KEY is set)
JOURNEY_BUDGET_SECONDS=900

# --- Backend API load test for native runs (GET only, bounded; off unless enabled here or on the form) ---
LOAD_TEST_ENABLED=false
# Deployed API origin; empty = the origin found in the app's code (e.g. a SERVER_URL constant)
LOAD_TEST_BASE_URL=
LOAD_TEST_USERS=10
LOAD_TEST_DURATION_SECONDS=30
LOAD_TEST_MAX_RPS=20
# Pass / fail thresholds
LOAD_TEST_P95_MS=1000
LOAD_TEST_MAX_ERROR_RATE=0.01
LOAD_TEST_MAX_ENDPOINTS=3
# Optional: explicit GET paths (comma separated, e.g. /api/health,/api/results) instead of discovery
LOAD_TEST_ENDPOINTS=
# Optional: bearer token for endpoints behind sign-in (never logged)
LOAD_TEST_BEARER_TOKEN=
