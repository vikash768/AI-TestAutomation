# =============================================================================
# AI Testing Automation — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# =============================================================================

# --- Application Under Test ---
# Primary target: TrackPilot
BASE_URL=https://trackpilot.pods365.com
VALID_USER_EMAIL=
VALID_USER_PASSWORD=

# Fallback target: local demo app (set BASE_URL=http://demo-app for offline use)
# BASE_URL=http://demo-app

# --- AI Configuration ---
GEMINI_API_KEY=

# --- Project Identity ---
PROJECT_NAME=poc
BROWSER=chrome

# --- Selenium ---
SELENIUM_REMOTE_URL=http://selenium:4444
SELENIUM_PORT=4444
SELENIUM_VNC_PORT=7900

# --- Demo App ---
DEMO_APP_PORT=8080

# --- Observability ---
PUSHGATEWAY_URL=http://pushgateway:9091
PUSHGATEWAY_PORT=9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
