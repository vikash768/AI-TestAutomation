# =============================================================================
# AI Testing Automation — Test Runner Container
# =============================================================================
# Supports two execution modes:
#   1. Robot Framework: robot [args] tests/robot/suites/...
#   2. AI Runner:       python -m automation.runner --suite <file>
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="AI Testing Automation"
LABEL description="Test runner with Robot Framework, AI test engine, and Prometheus metrics"

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /opt/testing

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --timeout=300 --retries=3 -r requirements.txt

# Copy project files
COPY automation/ ./automation/
COPY tests/ ./tests/
COPY testsuites/ ./testsuites/

# Create artifacts directories
RUN mkdir -p /opt/testing/artifacts/robot \
             /opt/testing/artifacts/screenshots \
             /opt/testing/artifacts/logs \
             /opt/testing/artifacts/runs

# Default environment variables (overridden by docker-compose / .env)
ENV SELENIUM_REMOTE_URL=http://selenium:4444
ENV PUSHGATEWAY_URL=http://pushgateway:9091
ENV BASE_URL=https://trackpilot.pods365.com
ENV BROWSER=chrome
ENV PROJECT_NAME=trackpilot
ENV PYTHONPATH=/opt/testing
ENV TEST_SUITE=testsuites/trackpilot.testsuite.md

# No fixed entrypoint — allows both robot and python commands
# Usage:
#   docker compose run --rm test-runner robot [args] tests/...
#   docker compose run --rm test-runner python -m automation.runner --suite ...
ENTRYPOINT []
CMD ["python", "-m", "automation.runner"]
