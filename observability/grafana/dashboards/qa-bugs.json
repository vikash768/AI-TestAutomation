     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT coalesce(nullif(fix_in, ''), 'unclassified') AS \"Fix in\",\n  count(*) FILTER (WHERE severity IN ('critical', 'high')) AS \"critical + high\",\n  count(*) FILTER (WHERE severity = 'medium') AS \"medium\",\n  count(*) FILTER (WHERE severity IN ('low', 'info')) AS \"low\"\nFROM findings WHERE run_id = '${run}' AND status IN ('reported', 'confirmed') GROUP BY 1 ORDER BY 1",
