  {
   "id": 8,
   "type": "table",
   "title": "Bugs to fix",
   "description": "Confirmed by the platform (deterministic check or reproduced). One row per bug; scroll right for How to fix and the screenshot.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "qa-postgres"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 22
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "qa-postgres"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT\n  f.id AS \"#\",\n  f.severity AS \"Severity\",\n  f.title AS \"Bug\",\n  regexp_replace(coalesce(\n      (SELECT e->>'path' FROM jsonb_array_elements(coalesce(f.evidence::jsonb, '[]'::jsonb)) e WHERE e->>'type' = 'screenshot' AND coalesce(e->>'path', '') <> '' LIMIT 1),\n      (SELECT p.screenshot FROM pages p WHERE p.run_id = f.run_id AND p.route = f.route AND coalesce(p.screenshot, '') <> '' ORDER BY p.id LIMIT 1),\n      ''), '^.*artifacts/', '${api_url}/artifacts/') AS \"Screenshot\",\n  f.fix_in AS \"Fix in\",\n  f.code_ref AS \"Code\",\n  CASE WHEN f.code_ref <> '' AND r.repo_url ~ '^https://(github|gitlab)\\.com/' AND coalesce(r.commit_sha, '') <> ''\n       THEN regexp_replace(r.repo_url, '\\.git$', '') || '/blob/' || r.commit_sha || '/' || split_part(f.code_ref, ':', 1)\n            || CASE WHEN split_part(f.code_ref, ':', 2) <> '' THEN '#L' || split_part(f.code_ref, ':', 2) ELSE '' END\n       ELSE '' END AS code_url,\n  f.fix AS \"How to fix\",\n  (SELECT string_agg(t.ord || '. ' || t.s, E'\\n' ORDER BY t.ord)\n     FROM jsonb_array_elements_text(coalesce(f.steps::jsonb, '[]'::jsonb)) WITH ORDINALITY AS t(s, ord)) AS \"Steps to reproduce\",\n  f.expected AS \"Expected\",\n  f.observed AS \"Actual\",\n  f.route AS \"Screen\",\n  f.category AS \"Category\",\n  f.standard_ref AS \"Standard\",\n  round(f.confidence::numeric, 2)::text || CASE WHEN f.reproduced_m > 0 THEN ' (' || f.reproduced_n || '/' || f.reproduced_m || ')' ELSE '' END AS \"Confidence\"\nFROM findings f JOIN runs r ON r.id = f.run_id\nWHERE f.run_id = '${run}' AND f.status IN ('reported', 'confirmed')\nORDER BY CASE f.severity WHEN 'critical' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 ELSE 4 END, f.fix_in, f.route, f.id",
     "refId": "A"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "lg",
    "footer": {
     "show": false
    },
    "sortBy": []
   },
