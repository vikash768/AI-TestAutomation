{
  "id": null,
  "uid": "test-execution-overview",
  "title": "AI Testing Automation \u2014 Test Execution Overview",
  "tags": [
    "testing",
    "automation",
    "qa"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(qa_test_total, project)",
        "includeAll": true,
        "default": "All"
      },
      {
        "name": "suite",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(qa_test_total, suite)",
        "includeAll": true,
        "default": "All"
      },
      {
        "name": "browser",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(qa_test_total, browser)",
        "includeAll": true,
        "default": "All"
      },
      {
        "name": "test_type",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(test_type)",
        "includeAll": true,
        "default": "All"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Last Run Status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(qa_test_failed{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"})",
          "datasource": "Prometheus",
          "legendFormat": "status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "PASS",
                  "color": "green"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1e-09,
                "to": 9999999999,
                "result": {
                  "text": "FAIL",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Tests",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(qa_test_total{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"})",
          "datasource": "Prometheus",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Passed",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(qa_test_passed{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"})",
          "datasource": "Prometheus",
          "legendFormat": "passed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Failed",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(qa_test_failed{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"})",
          "datasource": "Prometheus",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Skipped",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(qa_test_skipped{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"})",
          "datasource": "Prometheus",
          "legendFormat": "skipped"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        }
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "gauge",
      "title": "Pass Rate",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "avg(qa_test_pass_rate_ratio{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"}) * 100",
          "datasource": "Prometheus",
          "legendFormat": "pass_rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Suite Duration",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "avg(qa_suite_duration_seconds{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"})",
          "datasource": "Prometheus",
          "legendFormat": "duration"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Last Execution Time",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(qa_last_run_timestamp_seconds{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"}) * 1000",
          "datasource": "Prometheus",
          "legendFormat": "last_run"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        }
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Test Case Results",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "qa_test_case_status{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"}",
          "datasource": "Prometheus",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "Value": "Status",
              "test_id": "Test ID",
              "suite": "Suite",
              "project": "Project",
              "browser": "Browser",
              "test_type": "Test Type",
              "instance": "Instance",
              "job": "Job"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "PASS",
                        "color": "green"
                      },
                      "0": {
                        "text": "FAIL",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Pass Rate Trend",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "qa_test_pass_rate_ratio{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"} * 100",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Test Duration Trend",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "qa_suite_duration_seconds{project=~\"$project\", suite=~\"$suite\", browser=~\"$browser\", test_type=~\"$test_type\"}",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      }
    }
  ]
}