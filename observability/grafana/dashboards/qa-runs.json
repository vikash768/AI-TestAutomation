{
 "uid": "qa-runs",
 "title": "QA Runs",
 "tags": [
  "qa"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-30d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "project",
    "label": "Project",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "qa-postgres"
    },
    "query": "SELECT DISTINCT project FROM runs ORDER BY 1",
    "refresh": 2,
    "multi": false,
    "includeAll": false,
    "sort": 0,
    "definition": "SELECT DISTINCT project FROM runs ORDER BY 1"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Code components found (latest run)",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "qa-prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qa-prometheus"
     },
     "expr": "qa_latest_coverage_interaction_ratio{project=\"$project\"} * 100",
     "refId": "A",
     "legendFormat": "",
     "instant": true
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 60
       },
       {
        "color": "green",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 2,
   "title": "Reviewed precision (latest run)",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "qa-prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qa-prometheus"
     },
     "expr": "clamp_min(qa_latest_precision_ratio{project=\"$project\"}, 0) * 100",
     "refId": "A",
     "legendFormat": "",
     "instant": true
    }
   ],
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "green",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 3,
   "title": "Findings reported (latest run)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "qa-prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qa-prometheus"
     },
     "expr": "sum by (severity) (qa_latest_findings{project=\"$project\", status=~\"reported|confirmed\"})",
     "refId": "A",
     "legendFormat": "{{severity}}",
     "instant": true
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 6
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "colorMode": "background"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "critical"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "dark-red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "high"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "medium"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "low"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "info"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 4,
   "title": "Coverage per run",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "qa-postgres"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "qa-postgres"
     },
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT finished_at AS time, coalesce((stats->>'coverage_interaction')::float, (stats->>'coverage')::float) * 100 AS \"found after interaction %\", (stats->>'coverage')::float * 100 AS \"found at rest %\", (stats->>'tested_ratio')::float * 100 AS \"tested %\" FROM runs WHERE project = '${project}' AND status = 'completed' AND finished_at IS NOT NULL ORDER BY 1",
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "custom": {
      "drawStyle": "line",
      "showPoints": "always",
      "spanNulls": true
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Findings per run by severity",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "qa-postgres"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "qa-postgres"
     },
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT r.finished_at AS time, f.severity AS metric, count(*)::int AS value FROM findings f JOIN runs r ON r.id = f.run_id WHERE r.project = '${project}' AND r.status = 'completed' AND f.status IN ('reported','confirmed') GROUP BY 1, 2 ORDER BY 1",
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "critical"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "dark-red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "high"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "medium"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "low"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "info"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 6,
   "title": "Runs",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "qa-postgres"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "qa-postgres"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT created_at AS created, id, status, stage, live_url, commit_sha AS commit, framework, round((coalesce((stats->>'coverage_interaction')::float, (stats->>'coverage')::float) * 100)::numeric, 1) AS \"found %\", round(((stats->>'tested_ratio')::float * 100)::numeric, 1) AS \"tested %\", (stats->>'findings_total')::int AS findings, (stats->>'findings_needs_review')::int AS \"needs review\", (stats->>'tests')::int AS tests, (stats->>'pages')::int AS pages, (stats->>'duration_seconds')::float AS \"duration s\", message FROM runs WHERE project = '${project}' ORDER BY created_at DESC LIMIT 50",
     "refId": "A",
     "editorMode": "code"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 12
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "id"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open findings",
          "url": "/d/qa-findings/qa-findings?var-run=${__value.raw}"
         }
        ]
       }
      ]
     }
    ]
   }
  }
 ]
}