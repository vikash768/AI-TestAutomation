{
  "uid": "qa-categories",
  "title": "QA Categories",
  "tags": [
    "qa"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "qa-postgres"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "query": "SELECT id AS __value, id || ' \u00b7 ' || project || ' \u00b7 ' || to_char(created_at,'YYYY-MM-DD HH24:MI') AS __text FROM runs WHERE status='completed' ORDER BY created_at DESC",
        "definition": "SELECT id AS __value, id || ' \u00b7 ' || project || ' \u00b7 ' || to_char(created_at,'YYYY-MM-DD HH24:MI') AS __text FROM runs WHERE status='completed' ORDER BY created_at DESC"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Checklist coverage (did each test type run?)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qa-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qa-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT c.label AS \"test type\", CASE WHEN x.ran THEN 'yes' ELSE 'no' END AS ran, coalesce(x.tests,0) AS tests, coalesce(x.passed,0) AS passed, coalesce(x.failed,0) AS failed, coalesce(x.findings,0) AS findings FROM (VALUES ('functional','Functional (code-derived)'),('ui','UI & resize / accessibility'),('security','Security / penetration (non-destructive)'),('load','Load / performance'),('unit','Unit tests (codebase)'),('stability','Stability & UX')) AS c(key,label) LEFT JOIN (SELECT key AS category, (value->>'ran')::boolean AS ran, coalesce((value->>'tests')::int,0) AS tests, coalesce((value->>'pass')::int,0) AS passed, coalesce((value->>'fail')::int,0) AS failed, coalesce((value->>'blocked')::int,0) AS blocked, coalesce((value->>'findings')::int,0) AS findings FROM runs r, jsonb_each(coalesce(r.stats::jsonb->'categories','{}'::jsonb)) WHERE r.id = '${run}') x ON x.category=c.key ORDER BY c.label"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "wrapText": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ran"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "yes": {
                        "color": "green",
                        "index": 0
                      },
                      "no": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Tests per category",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qa-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qa-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT c.label AS category, coalesce(x.passed,0) AS passed, coalesce(x.failed,0) AS failed, coalesce(x.blocked,0) AS blocked FROM (VALUES ('functional','Functional (code-derived)'),('ui','UI & resize / accessibility'),('security','Security / penetration (non-destructive)'),('load','Load / performance'),('unit','Unit tests (codebase)'),('stability','Stability & UX')) AS c(key,label) LEFT JOIN (SELECT key AS category, (value->>'ran')::boolean AS ran, coalesce((value->>'tests')::int,0) AS tests, coalesce((value->>'pass')::int,0) AS passed, coalesce((value->>'fail')::int,0) AS failed, coalesce((value->>'blocked')::int,0) AS blocked, coalesce((value->>'findings')::int,0) AS findings FROM runs r, jsonb_each(coalesce(r.stats::jsonb->'categories','{}'::jsonb)) WHERE r.id = '${run}') x ON x.category=c.key ORDER BY c.label"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "category",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blocked"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Findings per category",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qa-postgres"
      },
      "gridPos": {
        "x": 14,
        "y": 8,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qa-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT category, findings FROM (SELECT key AS category, (value->>'ran')::boolean AS ran, coalesce((value->>'tests')::int,0) AS tests, coalesce((value->>'pass')::int,0) AS passed, coalesce((value->>'fail')::int,0) AS failed, coalesce((value->>'blocked')::int,0) AS blocked, coalesce((value->>'findings')::int,0) AS findings FROM runs r, jsonb_each(coalesce(r.stats::jsonb->'categories','{}'::jsonb)) WHERE r.id = '${run}') x WHERE findings > 0"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Findings in this run (every category)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qa-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qa-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT category, severity, status, route, title, standard_ref AS standard, round(confidence::numeric,2) AS confidence FROM findings WHERE run_id='${run}' ORDER BY CASE severity WHEN 'critical' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 ELSE 4 END, category"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "wrapText": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "high": {
                        "color": "orange",
                        "index": 1
                      },
                      "medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "low": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Load test",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Load test verdict",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qa-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "description": "pass / degraded / fail against the target p95; not measurable = endpoints answered 401/403. Knee = users at which response times started climbing.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qa-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT coalesce(r.stats::jsonb->'load'->>'verdict','not run') AS verdict, coalesce(r.stats::jsonb->'load'->>'knee_users','none') AS \"knee (users)\", coalesce(r.stats::jsonb->'load'->>'users','-') AS \"peak users\", coalesce(r.stats::jsonb->'load'->>'auth','-') AS \"signed in as\", CASE WHEN r.stats::jsonb->'load' IS NULL THEN '-' WHEN (r.stats::jsonb->'load'->>'aborted')::boolean THEN 'stopped early: ' || coalesce(r.stats::jsonb->'load'->>'abort_reason','') ELSE 'ran to completion' END AS \"run\" FROM runs r WHERE r.id='${run}'"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "pass": {
                  "color": "green",
                  "index": 0,
                  "text": "pass"
                },
                "degraded": {
                  "color": "orange",
                  "index": 1,
                  "text": "degraded"
                },
                "fail": {
                  "color": "red",
                  "index": 2,
                  "text": "fail"
                },
                "not_measurable": {
                  "color": "blue",
                  "index": 3,
                  "text": "not measurable"
                },
                "not run": {
                  "color": "text",
                  "index": 4,
                  "text": "not run"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Load test stages (1 \u2192 N users)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qa-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 30,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qa-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT t.ord AS stage, (t.s->>'users')::int AS users, round((t.s->>'seconds')::numeric,1) AS seconds, (t.s->>'requests')::int AS requests, round((t.s->>'rps')::numeric,1) AS rps, round((t.s->>'p50')::numeric) AS p50_ms, round((t.s->>'p95')::numeric) AS p95_ms, round((t.s->>'p99')::numeric) AS p99_ms, (t.s->>'server_errors')::int AS server_errors, (t.s->>'client_errors')::int AS client_errors, round((t.s->>'error_rate')::numeric*100,1) AS error_pct FROM runs r, jsonb_array_elements(coalesce(r.stats::jsonb->'load'->'stages','[]'::jsonb)) WITH ORDINALITY AS t(s, ord) WHERE r.id='${run}' ORDER BY t.ord"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "server_errors"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Peak p95 across recent runs (same project as the selected run)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qa-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "description": "Highest stage p95 per completed run that had a load test, for the selected run's project, next to that run's p95 target.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qa-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT r.created_at AS time, max((t.s->>'p95')::numeric) AS \"peak p95 ms\", max((r.stats::jsonb->'load'->>'p95_target_ms')::numeric) AS \"target p95 ms\" FROM runs r, jsonb_array_elements(coalesce(r.stats::jsonb->'load'->'stages','[]'::jsonb)) AS t(s) WHERE r.status='completed' AND r.project=(SELECT project FROM runs WHERE id='${run}') AND $__timeFilter(r.created_at) GROUP BY r.id, r.created_at ORDER BY r.created_at"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "target p95 ms"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Breaking point (capacity test)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "qa-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 5
      },
      "description": "pass / degraded / fail against the target p95; not measurable = endpoints answered 401/403. Knee = users at which response times started climbing.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "qa-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A",
          "rawSql": "SELECT coalesce(r.stats::jsonb->'load'->'capacity'->'breaking_point'->>'users', CASE WHEN r.stats::jsonb->'load'->'capacity' IS NULL THEN 'not run' ELSE 'none up to ' || (r.stats::jsonb->'load'->'capacity'->>'max_tested_users') END) AS \"breaks at (users)\", coalesce(r.stats::jsonb->'load'->'capacity'->'breaking_point'->>'p50','-') AS \"p50 ms at break\", coalesce(r.stats::jsonb->'load'->'capacity'->'breaking_point'->>'p95','-') AS \"p95 ms at break\", coalesce(r.stats::jsonb->'load'->'capacity'->'last_healthy'->>'users','-') AS \"last healthy (users)\", coalesce(r.stats::jsonb->'load'->'capacity'->'last_healthy'->>'p95','-') AS \"p95 ms last healthy\", coalesce(r.stats::jsonb->'load'->'capacity'->'breaking_point'->>'reason','-') AS reason FROM runs r WHERE r.id = '${run}'"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}